{
    "version": "0.2.0",
    "configurations": [
                {
            "name": "Vanna FastAPI + Vite HMR (前后端联调)",
            "type": "debugpy",
            "request": "launch",
            "module": "vanna.servers",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {"PYTHONPATH": "${workspaceFolder}/src"},
            "justMyCode": false,
            "args": ["--framework", "fastapi", "--host", "0.0.0.0", "--port", "9000", "--dev", "--static-folder", "http://localhost:5173"]
        },
